# Environment Variables Template (do not commit actual .env file)

# Database
MONGO_URI=mongodb://127.0.0.1:27017/cinema_booking

# First Super Admin seed values for npm run seed:super-admin
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@cinema.com
SUPER_ADMIN_PASSWORD=ChangeMe123!

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your_jwt_secret_key

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# Payment Gateway (Stripe, PayPal, etc.)
STRIPE_SECRET_KEY=your_stripe_key

# TMDB (The Movie Database)
TMDB_API_KEY=your_tmdb_api_key

# OpenAI (Chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Frontend
FRONTEND_URL=http://localhost:3000
